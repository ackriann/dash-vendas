# =====================================================================
# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables)
# =====================================================================

# ---- Endereço público do painel (sem barra no final)
APP_URL=https://seu-painel.vercel.app
APP_TIMEZONE=America/Sao_Paulo

# ---- Acesso ao painel
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Texto aleatório longo (ex.: rode `openssl rand -hex 32`)
SESSION_SECRET=

# ---- Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Meta: perfis entram por token + app (cadastrados no painel, em Perfis Meta)
# ou pelo botão "Entrar com Facebook", que usa este app (opcional)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0

# ---- Opcional: Vercel Cron (plano pago) chamando /api/cron/rules
CRON_SECRET=

# ---- Notificações push (gere com: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# ---- Webhooks (preencha só os que usar)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HOTMART_HOTTOK=
DIGISTORE_IPN_PASSPHRASE=
# Texto aleatório; vai na URL do webhook universal (?key=...)
UNIVERSAL_WEBHOOK_KEY=
